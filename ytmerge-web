#!/usr/bin/env bash
# ytmerge-web — start the local browser UI (http://localhost:8765).
#
#   ./ytmerge-web               start the server and open the page
#   ./ytmerge-web --no-open     start without opening a browser tab
#   ./ytmerge-web install       macOS: run it at login, always on (LaunchAgent)
#   ./ytmerge-web uninstall     macOS: remove the LaunchAgent
#
# Needs only python3 (macOS: `xcode-select --install` or python.org) and curl.
# yt-dlp is fetched automatically on first run; `brew install ffmpeg` unlocks
# full-quality (merged) video downloads.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVER="$HERE/web/server.py"
LABEL="com.ytmerge.web"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PORT="${YTMERGE_PORT:-8765}"

PY="$(command -v python3 || true)"
if [[ -z "$PY" ]]; then
  echo "python3 not found. On macOS run: xcode-select --install" >&2
  exit 1
fi

case "${1:-}" in
  install)
    [[ "$(uname -s)" == "Darwin" ]] || { echo "install is macOS-only" >&2; exit 1; }
    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
    # launchd starts with a bare PATH; include Homebrew so ffmpeg/yt-dlp are found.
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$PY</string><string>-u</string><string>$SERVER</string><string>--no-open</string><string>--port</string><string>$PORT</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <!-- Restart on crash only: a clean exit (e.g. "port busy") must not respawn-loop. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>$HOME/Library/Logs/ytmerge-web.log</string>
  <key>StandardErrorPath</key><string>$HOME/Library/Logs/ytmerge-web.log</string>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "ytmerge web now runs at login → http://localhost:$PORT  (log: ~/Library/Logs/ytmerge-web.log)"
    sleep 1 && open "http://localhost:$PORT"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST"
    echo "LaunchAgent removed."
    ;;
  *)
    exec "$PY" -u "$SERVER" --port "$PORT" "$@"
    ;;
esac
